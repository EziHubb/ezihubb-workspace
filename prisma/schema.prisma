// BF-02: Live Order Tracking
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

enum TrackingStage {
  ORDER_CONFIRMED
  SENT_TO_FULFILLMENT
  IN_PRODUCTION
  QUALITY_CHECK
  PACKAGED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model OrderTracking {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id])
  currentStage          TrackingStage @default(ORDER_CONFIRMED)
  carrierTrackingNumber String?
  carrierName           String?
  estimatedDeliveryMin  DateTime?
  estimatedDeliveryMax  DateTime?
  lastPolledAt          DateTime?
  rawCarrierData        Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  events TrackingEvent[]
}

model TrackingEvent {
  id          String        @id @default(cuid())
  trackingId  String
  tracking    OrderTracking @relation(fields: [trackingId], references: [id])
  stage       TrackingStage
  title       String
  description String?
  source      String
  eventAt     DateTime
  rawData     Json?
  createdAt   DateTime      @default(now())

  @@index([trackingId])
}

// ─── Fulfillment Providers (POD — Printify, and any future provider) ──────────
// Provider-agnostic: a new provider is a new FulfillmentProviderType value +
// a new class implementing FulfillmentProvider (apps/api/src/modules/fulfillment/)
// — no schema changes needed to add one.

enum FulfillmentProviderType {
  PRINTIFY
  MERCHIZE
}

// A store's top-level choice of how orders get fulfilled. MANUAL is not a
// "provider" in the StoreFulfillmentConnection sense — it needs no external
// account/API key — it's a declarative opt-out that tells the fulfillment
// queue to never auto-push orders, leaving the seller to ship them by hand
// via the existing order "mark shipped" / tracking flows.
enum StoreFulfillmentMode {
  AUTOMATIC
  MANUAL
}

enum FulfillmentConnectionStatus {
  ACTIVE
  INVALID
  DISCONNECTED
}

enum FulfillmentStatus {
  PENDING
  SUBMITTED
  IN_PRODUCTION
  FULFILLED
  FAILED
  NOT_APPLICABLE
}

model StoreFulfillmentConnection {
  id                     String                      @id @default(cuid())
  storeId                String
  store                  Store                       @relation(fields: [storeId], references: [id])
  provider               FulfillmentProviderType
  status                 FulfillmentConnectionStatus @default(ACTIVE)
  externalShopId         String
  externalShopName       String?
  encryptedApiKey        String                      @db.Text
  // Printify has no webhook-signing mechanism (verified against their OpenAPI
  // spec — no secret/signature concept exists). Security instead relies on an
  // opaque per-connection token embedded in the registered callback URL itself:
  // POST /webhooks/printify/{webhookToken}.
  webhookToken           String?                     @unique
  externalWebhookIds     String[]                    @default([])
  // Provider-specific webhook verification secret (e.g. Merchize's
  // merchize-webhook-key value) — null for providers with no such concept
  // (Printify relies solely on the opaque webhookToken above).
  encryptedWebhookSecret String?                     @db.Text
  lastVerifiedAt         DateTime?
  lastErrorMessage       String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  productMappings ProductFulfillmentMapping[]
  fulfillments    StoreOrderFulfillment[]

  @@unique([storeId, provider])
  @@index([storeId])
}

model ProductFulfillmentMapping {
  id                String                     @id @default(cuid())
  connectionId      String
  connection        StoreFulfillmentConnection @relation(fields: [connectionId], references: [id])
  productId         String
  product           Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant?            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  externalProductId String // Printify product id within the seller's shop
  externalVariantId String // Printify variant id within that product
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([productId, variantId])
  @@index([connectionId])
}

model StoreOrderFulfillment {
  id              String                     @id @default(cuid())
  storeOrderId    String
  storeOrder      StoreOrder                 @relation(fields: [storeOrderId], references: [id])
  connectionId    String
  connection      StoreFulfillmentConnection @relation(fields: [connectionId], references: [id])
  externalOrderId String?
  status          FulfillmentStatus          @default(PENDING)
  errorMessage    String?                    @db.Text
  pushedAt        DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([storeOrderId, connectionId])
  @@unique([connectionId, externalOrderId])
}

// ─── Partner API (inbound — 3rd-party tools integrating INTO a seller's store) ─
// Opposite direction from the fulfillment connections above: a seller issues
// one of these to a 3rd-party tool (listing automation, etc.) so it can call
// our API on their behalf. Hash-and-lookup like RefreshToken — the raw key is
// shown once at creation and never stored/retrievable again.

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([storeId])
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

enum CampaignSeason {
  spring
  summer
  autumn
  winter
}

model Campaign {
  id           String          @id @default(cuid())
  name         String
  season       CampaignSeason?
  isActive     Boolean         @default(false)
  bannerText   String          @default("")
  ctaLabel     String          @default("Shop now")
  ctaHref      String          @default("/products")
  countdownEnd DateTime?
  gradient     String          @default("")
  primaryColor String          @default("#000000")
  accentColor  String          @default("#000000")
  bgColor      String          @default("#ffffff")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive])
  @@index([season])
}

// ─── Search Analytics (Marketplace Insights) ──────────────────────────────────
// Platform-wide, per-day keyword stats. Flushed nightly from Redis (see
// AnalyticsService.flushDailySearchStats / ScheduledProcessor) rather than
// written per-request — durable history for the seller-facing keyword
// research tool, since Redis alone only keeps a rolling 7-day window.
// Retention: rows older than 90 days are pruned by the same nightly job.
model SearchTermDailyStat {
  id           String   @id @default(cuid())
  term         String
  date         String   // YYYY-MM-DD
  searches     Int      @default(0)
  resultsCount Int      @default(0)
  clicks       Int      @default(0)
  purchases    Int      @default(0)
  // Dominant category slug among that day's matching results for this term
  // (most-common category on the page of results actually returned, not an
  // explicit filter — most searches don't set one). Null until enough
  // matching products exist to infer one, or for days before this was added.
  category     String?
  createdAt    DateTime @default(now())

  @@unique([term, date])
  @@index([date])
  @@index([category, date])
}

/** A seller "watchlisting" a keyword in the marketplace-insights tool, to
 *  revisit its trend later — mirrors Etsy Shop Manager's "Saved searches". */
model SavedSearchTerm {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@unique([userId, term])
  @@index([userId])
}

/** Thumbs up/down on a "similar search term" suggestion — SearchService.
 *  getRelated() uses the net score to re-rank/filter future suggestions for
 *  the same source term, so the "related terms" list actually improves from
 *  feedback instead of just collecting unused signal. */
model RelatedTermFeedback {
  id            String   @id @default(cuid())
  sourceTerm    String
  relatedTerm   String
  helpfulCount    Int    @default(0)
  notHelpfulCount Int    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([sourceTerm, relatedTerm])
  @@index([sourceTerm])
}
