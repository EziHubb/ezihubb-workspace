generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum Provider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  GIFT_CARD
  MIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

// ── Product creation metadata (Image 13-14: "How It's Made" tab) ──────────────

enum WhoMadeIt {
  I_DID
  SHOP_MEMBER
  ANOTHER_COMPANY
}

enum HowItWasMade {
  MADE_TO_ORDER
  HANDMADE
  ASSEMBLED
  ALTERED
  CURATED_SET
  NATURAL_MATERIAL
}

enum RenewalType {
  AUTOMATIC
  MANUAL
}

enum ProcessingProfileType {
  MADE_TO_ORDER
  READY_TO_SHIP
}

// What a seller charges for one row of a delivery profile's standard
// delivery table (Etsy's "What you'll charge"). CALCULATED (weight/carrier
// API-based) is intentionally not modeled yet — out of scope for now.
enum ShippingChargeType {
  FIXED
  FREE
}

enum ReturnPolicy {
  NO_RETURNS
  RETURNS_ACCEPTED
  EXCHANGES_ONLY
}

enum DimensionUnit {
  CM
  IN
  MM
  M
}

enum ProductStatus {
  DRAFT // Being created — not yet published
  ACTIVE // Live and visible to buyers
  INACTIVE // Hidden from buyers, can be re-activated
  ARCHIVED // Soft-archived (replaces deletedAt pattern)
}

enum AffiliateStatus {
  PENDING // applied, waiting admin review
  ACTIVE // approved, can generate links
  SUSPENDED // temporarily disabled by admin
  REJECTED // application denied
}

enum CommissionStatus {
  PENDING // order placed, commission created
  CONFIRMED // 14 days after DELIVERED, locked
  APPROVED // admin approved for payout
  PAID // admin marked as paid
  CANCELLED // order refunded, commission voided
}

enum PayoutStatus {
  REQUESTED // affiliate submitted payout request
  PROCESSING // admin acknowledged
  PAID // transfer done, admin marked paid
  REJECTED // admin rejected (under threshold, fraud, etc.)
}

// ─── Multi-vendor enums ───────────────────────────────────────────────────────

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerLedgerEntryType {
  SALE
  TRANSACTION_FEE
  PAYMENT_PROCESSING_FEE
  REGULATORY_FEE
  LISTING_FEE
  ADJUSTMENT
}

enum SellerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CategoryScope {
  PLATFORM
  STORE
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  phone           String?
  role            Role      @default(CUSTOMER)
  isEmailVerified Boolean   @default(false)
  provider        Provider  @default(EMAIL)
  providerId      String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cartEmailToken  String? @unique
  cartEmailOptOut Boolean @default(false)

  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?
  backupCodes    String[]

  // ── Seller fields ──────────────────────────────────────────────────────────
  isSeller    Boolean @default(false)
  storeId     String? // denormalized store id (set when approved); no FK to avoid circular ref
  permissions Json? // per-user granular permissions (ADMIN role only); null = use role defaults

  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  addresses           Address[]
  wishlistItems       WishlistItem[]
  cart                Cart?
  orders              Order[]              @relation("UserOrders")
  customizationDrafts CustomizationDraft[]
  reviews             Review[]
  notifications       Notification[]
  conversations       Conversation[]
  affiliateAccount    AffiliateAccount?
  ownedStore          Store?               @relation("StoreOwner")
  savedSearchTerms    SavedSearchTerm[]

  wishlistShareToken String? @unique
  wishlistIsPublic   Boolean @default(false)
  wishlistName       String? @db.VarChar(100)

  pushEnabled Boolean    @default(true)
  fcmTokens   FcmToken[]

  adminNotes  String?   @db.Text
  adminTags   String[]
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  @@index([email])
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
}

// ─── User Profile ────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("US")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Multi-vendor: Store & Plans ─────────────────────────────────────────────

model Store {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  description     String?              @db.Text
  logoUrl         String?
  bannerUrl       String?
  ownerId         String               @unique
  owner           User                 @relation("StoreOwner", fields: [ownerId], references: [id])
  status          StoreStatus          @default(PENDING)
  // ISO 3166-1 alpha-2 country code — used to determine regulatory operating
  // fee eligibility (see PlatformSettings.regulatoryFeeCountries). Nullable
  // for existing stores that predate this field; no fee applies until set.
  country         String?              @db.VarChar(2)
  adminNotes      String?              @db.Text
  rejectedReason  String?
  verifiedAt      DateTime?
  approvedById    String?
  fulfillmentMode StoreFulfillmentMode @default(AUTOMATIC)

  // ── Order processing schedule (Etsy: Delivery settings → Order processing
  // schedule) — Monday–Friday is always on and not configurable; a seller can
  // additionally opt Saturday and/or Sunday into their processing week so
  // dispatch-by-date estimates account for weekend prep. ──────────────────────
  processesOnSaturday Boolean @default(false)
  processesOnSunday   Boolean @default(false)

  // Shop-level switch for paid expedited-delivery upgrades (Etsy: Delivery
  // settings → Upgrades). Per-profile upgrade options (name/price/SLA) are
  // intentionally out of scope for now — this only gates whether the seller
  // has opted the feature on at all.
  deliveryUpgradesEnabled Boolean @default(false)

  // Denormalized stats
  totalProducts Int     @default(0)
  totalOrders   Int     @default(0)
  totalRevenue  Decimal @default(0) @db.Decimal(12, 2)
  rating        Decimal @default(0) @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderationStatus ModerationStatus @default(PENDING)
  lastModeratedAt  DateTime?
  strikeCount      Int              @default(0)
  strikeRecords    StrikeRecord[]

  products         Product[]
  categories       Category[]
  storeOrders      StoreOrder[]
  ledgerEntries    SellerLedgerEntry[]
  payouts          SellerPayout[]
  shopSections       ShopSection[]
  shippingProfiles   ShippingProfile[]
  processingProfiles ProcessingProfile[]
  promotions       Promotion[]
  reviews          Review[]            @relation("StoreReviews")
  conversations    Conversation[]

  // ── Performance Score (NFT-03) ────────────────────────────────────────────
  performanceScore      Int?
  scoreShipping         Int?
  scoreRefund           Int?
  scoreReview           Int?
  scoreResponse         Int?
  scoreBadge            String?
  scoreLastCalculatedAt DateTime?

  cartItems CartItem[] @relation("CartItemStore")

  fulfillmentConnections StoreFulfillmentConnection[]
  apiKeys                ApiKey[]

  @@index([slug])
  @@index([status])
  @@index([ownerId])
}

model StoreOrder {
  id             String                  @id @default(cuid())
  orderId        String
  order          Order                   @relation(fields: [orderId], references: [id])
  storeId        String
  store          Store                   @relation(fields: [storeId], references: [id])
  status         OrderStatus             @default(PENDING_PAYMENT)
  subtotal       Decimal                 @db.Decimal(10, 2)
  shippingCost   Decimal                 @default(0) @db.Decimal(10, 2)
  platformFee    Decimal                 @db.Decimal(10, 2)
  sellerEarnings Decimal                 @db.Decimal(10, 2)
  trackingNumber String?
  trackingUrl    String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  sellerNotes    String?
  payoutId       String?
  payout         SellerPayout?           @relation(fields: [payoutId], references: [id])
  items          OrderItem[]
  fulfillments   StoreOrderFulfillment[]
  ledgerEntries  SellerLedgerEntry[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([orderId, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

model SellerPayout {
  id            String              @id @default(cuid())
  storeId       String
  store         Store               @relation(fields: [storeId], references: [id])
  period        String
  amount        Decimal             @db.Decimal(10, 2)
  platformFee   Decimal             @db.Decimal(10, 2)
  orderCount    Int                 @default(0)
  status        SellerPayoutStatus  @default(PENDING)
  paidAt        DateTime?
  processedById String?
  paymentMethod String?
  paymentDetail String?
  adminNotes    String?
  storeOrders   StoreOrder[]
  ledgerEntries SellerLedgerEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([period])
}

model SellerLedgerEntry {
  id           String                @id @default(cuid())
  storeId      String
  store        Store                 @relation(fields: [storeId], references: [id])
  storeOrderId String?
  storeOrder   StoreOrder?           @relation(fields: [storeOrderId], references: [id])
  type         SellerLedgerEntryType
  // Signed: positive for SALE, negative for every fee type (TRANSACTION_FEE,
  // PAYMENT_PROCESSING_FEE, REGULATORY_FEE, LISTING_FEE). Summing a store's
  // unpaid (payoutId: null) rows gives the exact amount owed on next payout —
  // this table is the source of truth for payout batching, mirroring Etsy's
  // itemized "Payment account" statement.
  amount       Decimal               @db.Decimal(10, 2)
  description  String
  payoutId     String?
  payout       SellerPayout?         @relation(fields: [payoutId], references: [id])
  createdAt    DateTime              @default(now())

  @@index([storeId, payoutId])
}

model PlatformSettings {
  id                        String   @id @default("singleton")
  // ── Seller fees (modeled on Etsy's published fee schedule) ────────────────
  transactionFeeRate        Decimal  @default(0.065) @db.Decimal(5, 4) // 6.5% of subtotal + shipping
  paymentProcessingFeeRate  Decimal  @default(0.05) @db.Decimal(5, 4) // 5% of subtotal + shipping
  paymentProcessingFixedFee Decimal  @default(0.25) @db.Decimal(10, 2)
  listingFee                Decimal  @default(0.20) @db.Decimal(10, 2) // charged once per product created
  regulatoryFeeRate         Decimal  @default(0.0124) @db.Decimal(5, 4)
  regulatoryFeeCountries    String[] @default([]) // ISO 3166-1 alpha-2 codes; empty = applies to nobody
  platformName              String   @default("EziHubb")
  allowPublicRegistration   Boolean  @default(false)
  minPayoutAmount           Decimal  @default(100.00) @db.Decimal(10, 2)
  payoutSchedule            String   @default("monthly")
  maintenanceMode           Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  // 1 = nav tab (L1), 2 = group (L2), 3 = product category (L3)
  level       Int           @default(1)
  parentId    String?
  parent      Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]    @relation("CategoryTree")
  sortOrder   Int           @default(0)
  isVisible   Boolean       @default(true)
  scope       CategoryScope @default(PLATFORM)
  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products          Product[]
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([level, isVisible])
  @@index([storeId])
}

// ── Multi-category membership ─────────────────────────────────────────────────

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  bannerUrl   String?
  occasion    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  products CollectionProduct[]

  @@index([slug])
  @@index([isActive])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id                  String        @id @default(cuid())
  name                String
  slug                String
  sku                 String        @unique
  description         String
  shortDescription    String?
  // Postgres-generated (STORED, auto-maintained on every insert/update — see
  // migration 20260813140000). Prisma can't model tsvector natively; marking
  // it Unsupported keeps it visible in introspection without Prisma Client
  // trying to read/write it — search.service.ts touches it only via raw SQL.
  searchVector        Unsupported("tsvector")? @map("search_vector")
  basePrice           Decimal       @db.Decimal(10, 2)
  compareAtPrice      Decimal?      @db.Decimal(10, 2)
  isPersonalizable    Boolean       @default(true)
  isActive            Boolean       @default(true)
  status              ProductStatus @default(ACTIVE)
  productType         ProductType   @default(PHYSICAL)
  isFeatured          Boolean       @default(false)
  viewCount           Int           @default(0)
  soldCount           Int           @default(0)
  processingDays      Int           @default(3)
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  customizationConfig Json?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  moderationStatus ModerationStatus @default(PENDING)
  lastModeratedAt  DateTime?

  // ── Store ownership ─────────────────────────────────────────────────────────
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // ── TAB: Item Details ───────────────────────────────────────────────────────
  titleCharCount Int? // cached char count for 140-char limit validation

  // ── TAB: Item Attributes (structured, searchable like Etsy) ────────────────
  primaryColors   String[] // multi-select colour tags
  secondaryColors String[]
  materials       String[] // up to 5 materials
  occasions       String[] // up to 13 occasions
  holidayTags     String[]
  recipientTags   String[] // up to 4 recipients
  styles          String[]
  sustainability  String[] // up to 3 sustainability attributes
  width           Decimal?       @db.Decimal(8, 2) // physical dimensions, buyer-facing info — not shipping-package dimensions
  height          Decimal?       @db.Decimal(8, 2)
  dimensionUnit   DimensionUnit?

  // ── TAB: Pricing & Inventory ────────────────────────────────────────────────
  domesticGlobalPricing Boolean      @default(false)
  quantity              Int? // null = unlimited (POD)
  trackInventory        Boolean      @default(false)
  lowStockThreshold     Int?
  returnPolicy          ReturnPolicy @default(NO_RETURNS)

  // ── TAB: Processing & Shipping Profiles ─────────────────────────────────────
  processingProfileId String?
  processingProfile   ProcessingProfile? @relation(fields: [processingProfileId], references: [id])
  shippingProfileId   String?
  shippingProfile     ShippingProfile?   @relation(fields: [shippingProfileId], references: [id])

  // ── TAB: How It's Made ──────────────────────────────────────────────────────
  whoMadeIt            WhoMadeIt?
  howItWasMade         HowItWasMade?
  toolsUsed            String[] // "handheld" | "computerized" | "3d-printing" | "none"
  productionPartnerIds String[] // cuid references to ProductionPartner records
  hsCode               String? // Harmonised System tariff code for customs
  featuredRelatedIds   String[] // up to 4 manually pinned related product IDs

  // ── TAB: Settings ───────────────────────────────────────────────────────────
  shopSectionId String?
  shopSection   ShopSection? @relation(fields: [shopSectionId], references: [id])
  isAdsEnabled  Boolean      @default(false)
  renewalType   RenewalType  @default(AUTOMATIC)
  expiresAt     DateTime? // only relevant when renewalType = MANUAL

  // ── TAB: Photo & Video ──────────────────────────────────────────────────────
  videoUrls         String[] // up to 2 hosted video URLs
  thumbnailCropData Json? // { x, y, width, height } for thumbnail crop

  // ── Relations ───────────────────────────────────────────────────────────────
  variants            ProductVariant[]
  images              ProductImage[]
  collections         CollectionProduct[]
  tags                ProductTag[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  customizationDrafts CustomizationDraft[]
  reviews             Review[]
  questions           ProductQuestion[]
  productCategories   ProductCategory[]
  variationGroups     VariationGroup[]
  variationSettings   VariationSettings?
  fulfillmentMappings ProductFulfillmentMapping[]
  digitalFiles        DigitalFile[]

  @@unique([slug, storeId])
  @@index([categoryId])
  @@index([storeId])
  @@index([isActive, isFeatured])
  @@index([isActive, soldCount])
  @@index([processingProfileId])
  @@index([shippingProfileId])
  @@index([shopSectionId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  options           Json
  // Nullable — a newly-generated combination (from Manage Variations, when
  // "Prices vary" is on) starts blank until the seller fills it in, matching
  // Etsy's own per-combination price grid. Publish is blocked while any
  // isAvailable row still has a null price (see ProductsService).
  price             Decimal? @db.Decimal(10, 2)
  // Per-combination quantity — only meaningful when VariationSettings.variesBy
  // includes 'quantity'; otherwise Product.quantity applies to every combo.
  quantity          Int?
  sku               String?  @unique
  // The "Visible" toggle per combination row in the price grid, and also how
  // syncVariantsFromGroups() retires a combination that no longer matches the
  // seller's options — never hard-deleted (ProductFulfillmentMapping cascades
  // on delete, and CartItem/OrderItem/DigitalFile would silently lose their
  // variant link), just hidden from new selection.
  isAvailable       Boolean  @default(true)
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  lowStockThreshold Int?

  cartItems           CartItem[]
  orderItems          OrderItem[]
  customizationDrafts CustomizationDraft[]
  fulfillmentMappings ProductFulfillmentMapping[]
  digitalFiles        DigitalFile[]

  @@index([productId])
}

// MOCKUP = a normal catalog/display photo, shown to shoppers.
// PRINT_FILE = an isolated, background-removed design asset for one print
// area — never shown to shoppers, only used when pushing a fulfillment
// order to a POD provider (see FulfillmentLineItem.printFiles).
enum ProductImageType {
  MOCKUP
  PRINT_FILE
}

enum PrintSide {
  FRONT
  BACK
  SLEEVE
  HOOD
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  type      ProductImageType @default(MOCKUP)
  printSide PrintSide?

  @@index([productId])
  @@index([productId, type, printSide])
}

// A digital product's deliverable file (design file, PNG/SVG/PDF/etc — never
// a physical item). storageKey is never surfaced in any API response; the raw
// object is fetched server-side only, by the download endpoint, and stamped
// per-buyer before streaming — see order-downloads.controller.ts.
model DigitalFile {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String? // null = applies to all variants
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  filename   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([productId])
}

// ─── Variation System (ETY-01) ────────────────────────────────────────────────
// Represents the admin-configurable variation structure for a product.
// VariationGroup = a dimension (e.g. "Color", "Size")
// VariationOption = a value within that dimension (e.g. "Red", "Small")
// VariationSettings = product-level toggle + metadata

model VariationGroup {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // "Color", "Size", "Material"
  displayType String  @default("dropdown") // "dropdown" | "color_swatch" | "button" | "image"
  sortOrder   Int     @default(0)

  options VariationOption[]

  @@index([productId])
}

model VariationOption {
  id          String         @id @default(cuid())
  groupId     String
  group       VariationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String // "Red", "Small"
  value       String // slug / code, e.g. "red", "s"
  colorHex    String? // for color_swatch display type
  imageUrl    String? // for image display type (custom external URL)
  // Which product photo represents this variant option.
  // Intentionally no FK → ProductImage so image deletion doesn't cascade.
  imageId     String? // references ProductImage.id (soft reference)
  priceDelta  Decimal?       @db.Decimal(10, 2) // price adjustment from base
  sortOrder   Int            @default(0)
  isAvailable Boolean        @default(true)

  @@index([groupId])
}

model VariationSettings {
  id               String   @id @default(cuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  enableVariations Boolean  @default(false)
  variesBy         String[] // names of active VariationGroup dimensions
  skuPrefix        String? // e.g. "MLH-MUG" → variants become "MLH-MUG-RED-M"
}

// ─── Processing Profiles ──────────────────────────────────────────────────────
// Admin-defined production windows that can be assigned to products.

model ProcessingProfile {
  id        String                @id @default(cuid())
  name      String // "Made to order", "Ready to ship"
  type      ProcessingProfileType @default(MADE_TO_ORDER)
  minDays   Int                   @default(3)
  maxDays   Int                   @default(7)
  isDefault Boolean               @default(false)
  // Nullable for the handful of legacy platform-default profiles seeded
  // before per-store profiles existed (storeId: null, isDefault: true) —
  // every seller-created profile from here on always carries a storeId.
  storeId   String?
  store     Store?                @relation(fields: [storeId], references: [id])
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  products Product[]

  @@index([storeId])
}

// ─── Shipping Profiles ────────────────────────────────────────────────────────
// Seller-owned "Delivery profiles" (Etsy: Shop Manager → Settings → Delivery
// settings → Delivery profiles) — the sole source of shipping cost/timeline
// at checkout (see ShippingService.resolveSellerShippingCost()).

model ShippingProfile {
  id               String   @id @default(cuid())
  name             String // "Standard Shipping", "Embroidered Hat"
  activeListings   Int      @default(0) // denormalised count
  isDefault        Boolean  @default(false)
  originCountry    String   @default("VN") @db.VarChar(2) // ISO 3166-1 alpha-2
  originPostalCode String   @default("")
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  methods  ShippingProfileMethod[]
  products Product[]

  @@index([storeId])
}

model ShippingProfileMethod {
  id              String             @id @default(cuid())
  profileId       String
  profile         ShippingProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  destinationType String // "domestic" | "everywhere_else" | ISO country code
  // Named service from the platform's fixed carrier list (GHN, GHTK, DHL...)
  // or "OTHER" — when OTHER, carrierName holds the seller's free-text label
  // and minDays/maxDays become seller-entered instead of a known SLA.
  carrierService  String             @default("OTHER")
  carrierName     String? // free-text label, only meaningful when carrierService = "OTHER"
  chargeType      ShippingChargeType @default(FIXED)
  minDays         Int
  maxDays         Int
  // Null when chargeType = FREE — the row still carries a destination and
  // delivery-time SLA, just no cost.
  price           Decimal?           @db.Decimal(10, 2)
  extraItemPrice  Decimal?           @db.Decimal(10, 2) // additional item surcharge, FIXED only

  @@index([profileId])
}

// ─── Shop Sections ────────────────────────────────────────────────────────────
// Organise listings into labelled sections visible on the shop front.

model ShopSection {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())

  products Product[]

  @@index([storeId])
}

// ─── Production Partners ──────────────────────────────────────────────────────
// Third-party manufacturers or fulfilment partners disclosed on listings.

model ProductionPartner {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String? // "Country" or "City, Country"
  createdAt   DateTime @default(now())
}

// ─── Personalization ─────────────────────────────────────────────────────────

model CustomizationDraft {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String?
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  templateId     String
  data           Json
  previewUrl     String?
  uploadedImages Json?
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?

  @@index([userId, productId])
  @@index([sessionId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id             String    @id @default(cuid())
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?   @unique
  couponCode     String?
  discountAmount Decimal?  @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?

  items                CartItem[]
  abandonedEmailSentAt DateTime?
}

model CartItem {
  id                String          @id @default(cuid())
  cartId            String
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(10, 2)
  customizationData Json?
  previewUrl        String?
  // Search term that led the buyer to this product (via ?st= on the product
  // link), if any — carried over to OrderItem at checkout so purchases can be
  // attributed back to the keyword for marketplace-insights conversion rates.
  searchTerm        String?
  createdAt         DateTime        @default(now())

  storeId String?
  store   Store?  @relation("CartItemStore", fields: [storeId], references: [id])

  @@index([cartId])
  @@index([productId])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)
  guestEmail      String?
  status          OrderStatus @default(PENDING_PAYMENT)
  isDigital       Boolean     @default(false)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?     @default("US")
  shippingMethod  String?
  shippingCost    Decimal     @db.Decimal(10, 2)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  couponCode      String?
  trackingNumber  String?
  trackingUrl     String?
  carrier         String?
  trackerId       String?

  // ── Gift options ──────────────────────────────────────────────────────────
  isGift       Boolean @default(false)
  giftMessage  String? @db.VarChar(500)
  giftReceipt  Boolean @default(false)
  giftWrapping Boolean @default(false)
  giftFrom     String? @db.VarChar(100)

  note         String?
  privateNote  String?
  cancelReason String?
  cancelledAt  DateTime?
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items           OrderItem[]
  storeOrders     StoreOrder[]
  statusHistory   OrderStatusHistory[]
  payment         Payment?
  promotionUsages PromotionUsage[]
  giftCardUsages  GiftCardUsage[]
  conversations   Conversation[]

  // Affiliate attribution (null if not a referred order)
  affiliateId             String?
  affiliate               AffiliateAccount?    @relation(fields: [affiliateId], references: [id])
  affiliateDiscountAmount Decimal?             @db.Decimal(10, 2)
  commission              AffiliateCommission?

  // Label purchase (EasyPost)
  easypostShipmentId String?
  labelUrl           String?
  labelPurchasedAt   DateTime?
  labelCost          Decimal?       @db.Decimal(10, 2)
  shippingRateId     String?
  tracking           OrderTracking?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([affiliateId])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  customizationData Json?
  previewUrl        String?
  // Carried over from CartItem.searchTerm — see comment there.
  searchTerm        String?
  createdAt         DateTime        @default(now())

  // ── Snapshots (captured at order time, never changes) ──────────────────────
  productName     String
  variantName     String?
  productSlug     String?
  productImageUrl String?
  variantSnapshot Json?
  sku             String?

  // ── Store attribution ──────────────────────────────────────────────────────
  storeId      String?
  storeOrderId String?
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id])

  digitalDownloadLogs DigitalDownloadLog[]

  @@index([orderId])
  @@index([productId])
  @@index([storeOrderId])
  @@index([storeId])
}

// One row per digital-file download attempt — the audit trail backing
// per-buyer traceability (see DigitalFile / order-downloads.controller.ts).
model DigitalDownloadLog {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fileId       String
  ip           String?
  userAgent    String?
  downloadedAt DateTime  @default(now())

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id])
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  paypalOrderId         String?       @unique
  paypalCaptureId       String?
  giftCardCode          String?
  giftCardAmount        Decimal?      @db.Decimal(10, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(10, 2)
  refundedAt            DateTime?
  refundReason          String?
  paidAt                DateTime?
  providerEventId       String?       @unique
  createdAt             DateTime      @default(now())
}

model GiftCard {
  id           String    @id @default(cuid())
  code         String    @unique
  initialValue Decimal   @db.Decimal(10, 2)
  balance      Decimal   @db.Decimal(10, 2)
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  // Purchase metadata (set when a customer buys a gift card via Stripe)
  recipientEmail        String?
  recipientName         String?
  personalMessage       String? @db.Text
  purchasedByUserId     String?
  stripePaymentIntentId String? @unique

  usages GiftCardUsage[]
}

model GiftCardUsage {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  usedAt     DateTime @default(now())

  @@index([giftCardId])
  @@index([orderId])
}

// ─── Promotion ───────────────────────────────────────────────────────────────

model Promotion {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int          @default(1)
  currentUses    Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  description    String?
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id])
  createdAt      DateTime     @default(now())

  usages PromotionUsage[]

  @@index([code])
  @@index([isActive])
  @@index([storeId])
}

model PromotionUsage {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  userId      String?
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  usedAt      DateTime  @default(now())

  @@index([promotionId])
  @@index([userId])
  @@index([orderId])
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String
  rating          Int
  title           String?
  body            String
  imageUrls       String[]
  status          ReviewStatus @default(PENDING)
  adminReply      String?
  repliedAt       DateTime?
  sellerReply     String?
  sellerRepliedAt DateTime?
  helpfulCount    Int          @default(0)
  storeId         String?
  store           Store?       @relation("StoreReviews", fields: [storeId], references: [id])
  createdAt       DateTime     @default(now())

  moderationStatus ModerationStatus @default(PENDING)

  @@unique([userId, productId, orderId])
  @@index([productId, status])
  @@index([userId])
  @@index([storeId])
}

// ─── Product Q&A ─────────────────────────────────────────────────────────────

model ProductQuestion {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  question     String  @db.VarChar(500)
  askedByName  String  @db.VarChar(100)
  askedByEmail String?
  isGuest      Boolean @default(true)

  answer      String?   @db.Text
  answeredAt  DateTime?
  isPublished Boolean   @default(false)

  isSpam  Boolean @default(false)
  upvotes Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isPublished])
  @@index([productId, createdAt])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Attribute dictionary ─────────────────────────────────────────────────────
// Searchable attribute values per type.  Admin-seeded + extensible at runtime.

model AttributeValue {
  id    String @id @default(cuid())
  type  String // "color" | "material" | "occasion" | "holiday" | "recipient" | "style" | "sustainability"
  value String

  @@unique([type, value])
  @@index([type])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

enum ConversationStatus {
  OPEN // active, needs attention
  PENDING // waiting for customer reply
  RESOLVED // marked done by admin
  SPAM // marked as spam
}

enum SenderType {
  CUSTOMER // message from buyer
  SHOP // message from shop/admin
  SYSTEM // automated message (order update, etc.)
}

model Conversation {
  id String @id @default(cuid())

  // A conversation belongs to either a specific order, or is general inquiry
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // The customer side
  userId     String? // null if guest
  user       User?   @relation(fields: [userId], references: [id])
  guestEmail String? // for guest conversations
  guestName  String?

  // Store context (which store this conversation is with)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // Metadata
  subject       String? // optional subject line
  status        ConversationStatus @default(OPEN)
  lastMessage   String? // preview of last message (denormalized)
  lastMessageAt DateTime?

  // Unread counts (denormalized for badge display)
  unreadByAdmin    Int @default(0)
  unreadByCustomer Int @default(0)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([storeId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Who sent it
  senderType SenderType
  senderId   String? // userId if customer, adminId if shop

  body           String   @db.Text
  attachmentUrls String[] // up to 3 image attachments

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  moderationStatus ModerationStatus @default(CLEAN)

  @@index([conversationId])
  @@index([createdAt])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Affiliate Program ────────────────────────────────────────────────────────

model AffiliateSettings {
  id                String   @id @default("singleton") // enforces 1 row
  defaultRate       Decimal  @default(0.10) @db.Decimal(5, 4) // 10%
  buyerDiscountRate Decimal  @default(0.05) @db.Decimal(5, 4) // 5%
  cookieDays        Int      @default(30)
  minPayoutAmount   Decimal  @default(50.00) @db.Decimal(10, 2)
  lockDays          Int      @default(14) // days after DELIVERED → CONFIRMED
  isEnabled         Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model AffiliateAccount {
  id String @id @default(cuid())

  // Identity — affiliate may or may not be a registered customer
  email            String  @unique
  firstName        String
  lastName         String
  website          String? // their blog/social URL
  promoDescription String? // how they plan to promote

  // Optional link to a User account (if affiliate is also a buyer)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Referral identity
  referralCode String  @unique // e.g. "SARAH2024"
  referralUrl  String? // computed: base_url?ref=CODE

  // Commission config
  commissionRate Decimal?        @db.Decimal(5, 4) // null = use global default
  status         AffiliateStatus @default(PENDING)

  // Financial summary (denormalized for dashboard speed)
  balance     Decimal @default(0) @db.Decimal(10, 2) // confirmed, unpaid
  totalEarned Decimal @default(0) @db.Decimal(10, 2) // all-time paid+confirmed

  // Admin notes
  adminNotes     String?
  rejectedReason String?
  approvedAt     DateTime?
  approvedById   String?

  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralCode])
  @@index([status])
  @@index([email])
}

model AffiliateClick {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  visitorId   String // random UUID stored in cookie
  ip          String?
  userAgent   String?
  landingPage String // full URL they landed on
  referrer    String? // where they came from

  convertedAt DateTime? // set when visitor places an order
  orderId     String? // FK if converted

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([visitorId])
  @@index([createdAt])
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  orderId String @unique // one commission per order
  order   Order  @relation(fields: [orderId], references: [id])

  baseAmount Decimal          @db.Decimal(10, 2) // order subtotal used
  rate       Decimal          @db.Decimal(5, 4) // rate at time of order
  amount     Decimal          @db.Decimal(10, 2) // baseAmount × rate
  status     CommissionStatus @default(PENDING)

  confirmedAt  DateTime? // 14d after delivery
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model AffiliatePayout {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  amount Decimal      @db.Decimal(10, 2)
  status PayoutStatus @default(REQUESTED)

  // Payment details (affiliate fills in)
  paymentMethod String // "paypal", "bank_transfer", "store_credit"
  paymentDetail String // PayPal email / bank account / etc.

  // Admin
  adminNotes    String?
  processedAt   DateTime?
  processedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

// ─── Admin Settings ───────────────────────────────────────────────────────────

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailTemplateOverride {
  id        String   @id @default(cuid())
  slug      String   @unique
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── i18n Translations ────────────────────────────────────────────────────────
// Polymorphic translation table for DB-stored content (product names, category
// names, descriptions, etc.). English is the source language stored on the
// entity itself; translations live here.

model Translation {
  id               String   @id @default(cuid())
  entityType       String // "Product" | "Category" | "Collection" | "Tag" | "ShopSection"
  entityId         String
  locale           String // "vi" | "fr" | "zh" — never "en"
  field            String // "name" | "description" | "seoTitle" | "seoDescription"
  value            String   @db.Text
  isAutoTranslated Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId, locale])
  @@index([locale])
}

// ─── Moderation ───────────────────────────────────────────────────────────────

enum ModerationStatus {
  PENDING // just created, awaiting moderation
  CLEAN // passed moderation
  FLAGGED // auto-flagged, awaiting admin review
  REJECTED // admin confirmed violation, content hidden
  APPEALED // seller appealed, awaiting re-review
  APPROVED // admin overrode, restored despite flag
}

model ModerationLog {
  id String @id @default(cuid())

  entityType  String
  entityId    String
  fieldName   String?
  contentHash String

  verdict       ModerationStatus
  severity      String
  categories    String[]
  confidence    Float
  reasoning     String?          @db.Text
  sellerMessage String?          @db.Text

  provider     String   @default("claude")
  modelVersion String?
  latencyMs    Int?
  cost         Decimal? @db.Decimal(10, 6)

  triggeredBy String
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNotes  String?   @db.Text

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([verdict])
  @@index([createdAt])
  @@index([contentHash])
}

model ModerationSettings {
  id String @id @default("singleton")

  isEnabled Boolean @default(true)

  moderateProductText Boolean @default(true)
  moderateStoreText   Boolean @default(true)
  moderateReviews     Boolean @default(true)
  moderateMessages    Boolean @default(true)
  moderateImages      Boolean @default(true)

  autoCriticalBlock Boolean @default(true)
  autoHighFlag      Boolean @default(true)
  autoMediumFlag    Boolean @default(true)
  autoLowWarn       Boolean @default(true)

  cacheCleanResultDays Int @default(30)

  strikeEnabled       Boolean @default(true)
  strikeLimitHigh     Int     @default(3)
  strikeLimitCritical Int     @default(1)
  strikeWindowDays    Int     @default(30)

  maxDailyApiCalls Int     @default(10000)
  maxCostPerDayUsd Decimal @default(50.00) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

model ModerationRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  ruleType    String
  value       String
  severity    String
  isActive    Boolean  @default(true)
  applyTo     String[]
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([ruleType, isActive])
}

model StrikeRecord {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  severity  String
  logId     String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

