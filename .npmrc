# pnpm resilience against transient npm registry slowness/timeouts (a
# jest-runtime tarball once timed out mid-download at 17 KiB/s and failed
# the whole docker-publish build-client job). Read automatically by pnpm
# from the working directory — both by GH Actions runners doing a native
# `pnpm install` (ci.yml) and, once copied in, by docker/Dockerfile's
# `base` stage.
fetch-timeout=300000
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
