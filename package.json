{
  "name": "maple-loom-handmade",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm nx run-many -t serve -p client admin api --parallel=3",
    "build": "pnpm nx run-many -t build",
    "lint": "pnpm nx affected -t lint",
    "test": "pnpm nx affected -t test",
    "test:api": "pnpm nx test api",
    "test:api:e2e": "jest --config apps/api/test/jest-e2e.cts --runInBand",
    "test:client": "pnpm nx test client",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm nx run-many -t test",
    "test:affected": "pnpm nx affected -t test",
    "graph": "pnpm nx graph",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
