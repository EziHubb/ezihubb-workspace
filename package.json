{
  "name": "ezihubb",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "postinstall": "node scripts/patch-next-build.cjs",
    "prepare": "node scripts/prisma-generate-if-present.cjs",
    "dev": "pnpm nx run-many -t serve -p client admin api --parallel=3",
    "build": "pnpm nx run-many -t build && node scripts/postbuild.mjs",
    "lint": "pnpm nx affected -t lint",
    "graph": "pnpm nx graph",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:seed:baseline": "pnpm exec tsx prisma/seed-baseline.ts",
    "db:seed:mongo": "pnpm exec tsx prisma/seeds/mongo/index.ts",
    "db:drop:pg": "node scripts/guard-destructive-db.cjs && prisma db execute --file=prisma/scripts/drop-pg.sql",
    "db:drop:mongo": "pnpm exec tsx prisma/seeds/mongo/drop.ts",
    "db:reset:pg": "node scripts/guard-destructive-db.cjs && prisma migrate reset --force --schema=prisma/schema.prisma",
    "db:reset:mongo": "pnpm exec tsx prisma/seeds/mongo/drop.ts",
    "db:reset": "pnpm db:reset:pg && pnpm db:reset:mongo",
    "db:fresh": "pnpm db:reset:pg && pnpm db:seed",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "migrate:products": "ts-node scripts/migrate-products-to-mongo.ts"
  },
  "dependencies": {
