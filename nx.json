{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/jest.config.ts",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "@nx/next:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "NEXT_PUBLIC_API_URL"
        },
        {
          "env": "NEXT_PUBLIC_NEXTAUTH_URL"
        },
        {
          "env": "NEXT_PUBLIC_CDN_URL"
        },
        {
          "env": "NEXT_PUBLIC_CLIENT_URL"
        },
        {
          "env": "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
        },
        {
          "env": "NEXT_PUBLIC_PAYPAL_CLIENT_ID"
        },
        {
          "env": "NEXT_PUBLIC_GA_ID"
        },
        {
          "env": "NEXT_PUBLIC_GTM_ID"
        },
        {
          "env": "NEXT_PUBLIC_META_PIXEL_ID"
        },
        {
          "env": "NEXT_PUBLIC_PINTEREST_TAG_ID"
        },
        {
          "env": "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION"
        },
        {
          "env": "NEXT_PUBLIC_SENTRY_DSN"
        },
        {
          "env": "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_API_KEY"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_PROJECT_ID"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_APP_ID"
        },
        {
          "env": "NEXT_PUBLIC_FIREBASE_VAPID_KEY"
        },
        {
          "env": "NEXT_PUBLIC_ADMIN_URL"
        },
        {
          "env": "NEXT_PUBLIC_HOTJAR_ID"
        },
        {
          "env": "NEXT_PUBLIC_GA_DASHBOARD_URL"
        },
        {
          "env": "NEXT_PUBLIC_BUILD_VERSION"
        },
        {
          "env": "NEXT_PUBLIC_GA_MEASUREMENT_ID"
        },
        {
          "env": "NEXT_PUBLIC_SITE_URL"
        },
        {
          "env": "API_URL"
        },
        {
          "env": "APP_URL"
        },
        {
          "env": "CLIENT_URL"
        },
        {
          "env": "ADMIN_URL"
        },
        {
          "env": "NEXTAUTH_URL"
        },
        {
          "env": "ANALYZE"
        }
      ],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "library": {
        "unitTestRunner": "jest"
      }
    }
  },
  "analytics": false,
  "nxCloudId": "6a751b7ddde6de79ef65f9f3"
}
