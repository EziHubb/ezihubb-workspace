<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if isConfirmation}}We got your message{{else}}New contact form submission{{/if}}</title>
  <style>
    body { font-family: Georgia, 'Times New Roman', serif; background: #faf9f7; margin: 0; padding: 0; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
    .header { background: #3d2b1f; padding: 32px 40px; text-align: center; }
    .header h1 { color: #f5e6d3; margin: 0; font-size: 22px; letter-spacing: 1px; }
    .body { padding: 40px; color: #3d2b1f; line-height: 1.7; }
    .body h2 { font-size: 20px; margin-top: 0; }
    .field { margin-bottom: 16px; }
    .field-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #7a5c45; font-weight: bold; }
    .field-value { background: #faf9f7; border-left: 3px solid #3d2b1f; padding: 10px 14px; margin-top: 4px; border-radius: 2px; font-size: 14px; }
    .footer { background: #f5e6d3; padding: 20px 40px; text-align: center; font-size: 12px; color: #7a5c45; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>🍁 Daily Daisy</h1>
    </div>
    <div class="body">
      {{#if isConfirmation}}
        <h2>We got your message, {{name}}!</h2>
        <p>Thanks for reaching out. Our team will review your message and get back to you within <strong>2 hours</strong> during business hours (Mon–Fri 9 AM–6 PM EST).</p>
        <p>Here's a copy of what you sent:</p>
      {{else}}
        <h2>New Contact Form Submission</h2>
        <p>A customer submitted the contact form. Details below:</p>
      {{/if}}

      <div class="field">
        <div class="field-label">Name</div>
        <div class="field-value">{{name}}</div>
      </div>
      <div class="field">
        <div class="field-label">Email</div>
        <div class="field-value">{{email}}</div>
      </div>
      <div class="field">
        <div class="field-label">Subject</div>
        <div class="field-value">{{subject}}</div>
      </div>
      {{#if orderNumber}}
      <div class="field">
        <div class="field-label">Order Number</div>
        <div class="field-value">{{orderNumber}}</div>
      </div>
      {{/if}}
      <div class="field">
        <div class="field-label">Message</div>
        <div class="field-value">{{message}}</div>
      </div>

      {{#if isConfirmation}}
        <p style="margin-top:24px;">In the meantime, you might find answers in our <a href="https://dailydaisy.com/pages/faq" style="color:#3d2b1f;">FAQ</a>.</p>
        <p>Warmly,<br /><strong>The Daily Daisy Team</strong></p>
      {{/if}}
    </div>
    <div class="footer">
      &copy; {{year}} Daily Daisy. All rights reserved.
    </div>
  </div>
</body>
</html>
