<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Invitation — EziHubb</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f0;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background:#1a1a1a;padding:32px 40px;text-align:center;">
              <h1 style="margin:0;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-0.3px;">EziHubb</h1>
              <p style="margin:6px 0 0;color:#999999;font-size:13px;">Admin Portal</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px;">
              <h2 style="margin:0 0 16px;color:#1a1a1a;font-size:20px;font-weight:700;">You've been invited to join the admin team</h2>
              <p style="margin:0 0 24px;color:#555555;font-size:15px;line-height:1.6;">
                {{invitedBy}} has given you <strong>{{role}}</strong> access to the EziHubb admin portal.
                Use the credentials below to log in for the first time.
              </p>

              <!-- Credentials box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f8f5;border:1px solid #e5e5e0;border-radius:6px;margin-bottom:24px;">
                <tr>
                  <td style="padding:24px;">
                    <p style="margin:0 0 12px;color:#888888;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;">Your login credentials</p>
                    <table cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding:4px 0;color:#888888;font-size:13px;width:110px;">Email</td>
                        <td style="padding:4px 0;color:#1a1a1a;font-size:14px;font-weight:600;font-family:monospace;">{{email}}</td>
                      </tr>
                      <tr>
                        <td style="padding:4px 0;color:#888888;font-size:13px;">Password</td>
                        <td style="padding:4px 0;color:#1a1a1a;font-size:14px;font-weight:600;font-family:monospace;letter-spacing:1px;">{{tempPassword}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Warning -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#fff8ed;border:1px solid #ffd07a;border-radius:6px;margin-bottom:28px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0;color:#7a4f00;font-size:13px;line-height:1.6;">
                      ⚠️ <strong>Change your password</strong> immediately after your first login.
                      This temporary password will remain active until you update it.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
                <tr>
                  <td style="background:#1a1a1a;border-radius:6px;padding:14px 28px;">
                    <a href="{{adminUrl}}" style="color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;">
                      Sign In to Admin Portal →
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin:0;color:#888888;font-size:13px;line-height:1.6;">
                If you weren't expecting this invitation or believe it was sent in error, you can safely ignore this email.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#f8f8f5;border-top:1px solid #e5e5e0;padding:24px 40px;text-align:center;">
              <p style="margin:0;color:#aaaaaa;font-size:12px;">
                © {{year}} EziHubb · This email was sent because an admin invitation was issued.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
