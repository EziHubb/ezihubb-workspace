# Copy to .env for local API development

NODE_ENV=development
PORT=3002
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://ezihubb:ezihubb_dev_pass@localhost:5432/ezihubb_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change_me_access_secret_must_be_64_characters_long_xxxxxxxxxx"
JWT_REFRESH_SECRET="change_me_refresh_secret_must_be_64_chars_long_xxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REMEMBER_ME_EXPIRES_IN="90d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3002/api/v1/auth/google/callback"

# Storage (MinIO locally)
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET="ezihubb-assets"
AWS_S3_REGION="auto"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin123"
CDN_URL="http://localhost:9000/ezihubb-assets"
UPLOAD_TEMP_PREFIX="uploads/temp/"
UPLOAD_PERMANENT_PREFIX="uploads/"
PREVIEW_PREFIX="previews/"
TEMPLATE_PREFIX="templates/"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Email (MailHog locally)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@ezihubb.com"
EMAIL_FROM_NAME="EziHubb"

# AI / Background Removal
BG_REMOVAL_PROVIDER="remove_bg"
BG_REMOVAL_API_KEY=""
BG_REMOVAL_API_URL="https://api.remove.bg/v1.0/removebg"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Monitoring
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="ezihubb-dev"
