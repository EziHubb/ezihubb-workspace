# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000         # client storefront URL — prod: https://ezihubb.com
ADMIN_URL=http://localhost:3001       # admin panel URL — prod: https://admin.ezihubb.com — auto-added to CORS + NEXTAUTH_URL fallback
API_URL=http://localhost:3002         # prod: https://api.ezihubb.com — also used to build the Printify webhook callback URL (must be publicly reachable in prod)
FRONTEND_URL=http://localhost:3000
PORT=3002
# Host-only (127.0.0.1) ports docker-compose.yml (production, on the
# dedicated AWS EC2 instance) publishes client/admin/api on. The host's own
# nginx reverse-proxies ezihubb.com/admin.ezihubb.com/api.ezihubb.com to
# these — see scripts/nginx-ezihubb.conf. Not used in local dev.
CLIENT_PORT=3010
ADMIN_PORT=3011
API_PORT=3012

# ── Database — PostgreSQL (transactional) ───────────────────────────────────
# Local dev: point this at whatever Postgres you use (local install, Docker
# container you run yourself, or a remote dev DB). Production (EC2 + RDS
# free tier): point it at your RDS endpoint with `?sslmode=no-verify`, e.g.:
#   DATABASE_URL="postgresql://ezihubb:change_me@your-db.xxxxx.rds.amazonaws.com:5432/ezihubb?sslmode=no-verify"
# `sslmode=require` connects (still TLS-encrypted) but Prisma's pg driver
# adapter rejects RDS's cert chain — "self-signed certificate in certificate
# chain" — because Amazon RDS's CA isn't in Node's default trust store.
# `no-verify` keeps the connection encrypted, just skips chain validation.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Database — MongoDB (flexible product detail + mega-menu) ─────────────────
# Self-hosted via the `mongodb` service in docker-compose.yml (production).
# On the free-tier EC2 instance this is the easiest thing to offload if RAM
# gets tight — switch to a MongoDB Atlas free-tier cluster (512MB, free
# forever) by just changing this URI; no code or container
# changes needed either way.
MONGODB_URI="mongodb://ezihubb:change_me@mongodb:27017/ezihubb?authSource=admin"
# Only used by docker-compose.yml to bootstrap the `mongodb` container —
# keep these in sync with the credentials in MONGODB_URI above.
MONGO_ROOT_USER="ezihubb"
MONGO_ROOT_PASSWORD="change_me"

# ── Queue ────────────────────────────────────────────────────────────────────
# Set to true in dev when Redis is not available (disables job queues)
DISABLE_QUEUE=false
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change_me_access_secret_must_be_64_characters_long_xxxxxxxxxx"
JWT_REFRESH_SECRET="change_me_refresh_secret_must_be_64_chars_long_xxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REMEMBER_ME_EXPIRES_IN="90d"

# ── Secrets encryption (per-store 3rd-party credentials, e.g. Printify API keys) ─
# Base64-encoded 32-byte key — generate a real one per environment with:
#   openssl rand -base64 32
# Required at boot (the API crashes if missing/wrong length) so a misconfigured
# key never results in silently-stored plaintext credentials.
SECRETS_ENCRYPTION_KEY="REPLACE_ME_32_BYTE_BASE64_KEY_GENERATED_LOCALLY"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Must be non-empty even if unused: GoogleStrategy (passport-google-oauth20)
# constructs its OAuth2Strategy eagerly at app boot and throws if clientID is
# empty/undefined — the whole API crash-loops, not just Google login. Use a
# placeholder like below if you don't have real Google OAuth credentials yet.
GOOGLE_CLIENT_ID="placeholder-google-client-id"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3002/api/v1/auth/google/callback"
# Same value as GOOGLE_CLIENT_ID, exposed to the client bundle at build time —
# Google Identity Services (One Tap / "Sign in with Google" button) runs in the
# browser and needs the client ID directly; it is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="placeholder-google-client-id"

# ── Storage (Cloudflare R2 in prod, MinIO locally) ────────────────────────────
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET="ezihubb-assets"
AWS_S3_REGION="auto"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin123"
CDN_URL="http://localhost:9000/ezihubb-assets"

# ── Storage subfolders ────────────────────────────────────────────────────────
UPLOAD_TEMP_PREFIX="uploads/temp/"
UPLOAD_PERMANENT_PREFIX="uploads/"
PREVIEW_PREFIX="previews/"
TEMPLATE_PREFIX="templates/"

# ── Payment — Stripe ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY must be non-empty even if unused: PaymentsService and the
# Stripe webhook guard construct `new Stripe()` eagerly at app boot, and the
# SDK throws immediately if the key is empty — the whole API crash-loops.
# Use a placeholder if you don't have a real key yet; actual Stripe API calls
# will just fail with an auth error.
STRIPE_SECRET_KEY="sk_test_placeholder_not_configured"
STRIPE_PUBLISHABLE_KEY=""
# Joi validates this as Joi.string().optional() — present-but-empty ("") fails
# validation and crash-loops the API at boot, even though it's optional. Must
# be either unset entirely or a non-empty placeholder like this.
STRIPE_WEBHOOK_SECRET="whsec_placeholder_not_configured"

# ── Payment — PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_WEBHOOK_ID=""       # PayPal dashboard > Webhooks > webhook ID; leave empty in dev to skip signature verification

# ── Admin auth (NextAuth v4) ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3001"    # must be the full admin URL in production — prod: https://admin.ezihubb.com
NEXTAUTH_SECRET="change_me_nextauth_secret_min_32_chars"

# ── Email (SendGrid in prod, MailHog locally) ─────────────────────────────────
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@ezihubb.com"
EMAIL_FROM_NAME="EziHubb"
# Local dev (MailHog)
SMTP_HOST="localhost"
SMTP_PORT=1025
# Same Joi optional-but-empty-fails-validation gotcha as STRIPE_WEBHOOK_SECRET
# above — MailHog doesn't need real auth, but these can't be "".
SMTP_USER="placeholder-not-configured"
SMTP_PASS="placeholder-not-configured"

# ── AI / Background Removal ───────────────────────────────────────────────────
BG_REMOVAL_PROVIDER="remove_bg"
BG_REMOVAL_API_KEY=""
BG_REMOVAL_API_URL="https://api.remove.bg/v1.0/removebg"

# ── AI / Art style transform (apps/api/src/modules/customization/art-style.service.ts) ─
# Without this, POST /customization/art-style/start returns 400 "not configured".
REPLICATE_API_TOKEN=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origin whitelist enforced in apps/api/src/main.ts. "*" reflects
# any origin (dev only — the API refuses to boot with "*" when NODE_ENV=production).
CORS_ORIGINS="*"                      # prod: "https://ezihubb.com,https://www.ezihubb.com,https://admin.ezihubb.com"

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="ezihubb-dev"

# ── Next.js Client (NEXT_PUBLIC_* vars must be set at build time) ─────────────
NEXT_PUBLIC_API_URL="http://localhost:3002"   # prod: https://api.ezihubb.com — browser calls this directly, not via docker networking
NEXT_PUBLIC_CLIENT_URL="http://localhost:3000"   # prod: https://ezihubb.com — used by admin's "View on site"/"Preview" links
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_CDN_URL="http://localhost:9000/ezihubb-assets"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_PINTEREST_TAG_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Analytics — GA4 Measurement Protocol (server-side, not exposed to client) ─
GA_MEASUREMENT_ID=""        # same value as NEXT_PUBLIC_GA_ID (e.g. G-XXXXXXXXXX)
GA_API_SECRET=""            # GA4 Admin > Data Streams > your stream > Measurement Protocol API secrets

# ── Next.js Admin (NEXT_PUBLIC_* vars must be set at build time) ──────────────
# Direct link to the real GA4 property dashboard, shown as a "Google Analytics"
# nav item to Super Admin in platform-wide mode. Left blank, the link is simply
# omitted from the sidebar — e.g. https://analytics.google.com/analytics/web/#/p<PROPERTY_ID>/reports/intelligenthome
NEXT_PUBLIC_GA_DASHBOARD_URL=""
