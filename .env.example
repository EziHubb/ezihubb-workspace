# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000         # client storefront URL
ADMIN_URL=http://localhost:3001       # admin panel URL — auto-added to CORS + NEXTAUTH_URL fallback
API_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
PORT=3002

# ── Database — PostgreSQL (transactional) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Database — MongoDB (flexible product detail + mega-menu) ─────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.XXXXX.mongodb.net/?appName=Cluster0"

# ── Queue ────────────────────────────────────────────────────────────────────
# Set to true in dev when Redis is not available (disables job queues)
DISABLE_QUEUE=false
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change_me_access_secret_must_be_64_characters_long_xxxxxxxxxx"
JWT_REFRESH_SECRET="change_me_refresh_secret_must_be_64_chars_long_xxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REMEMBER_ME_EXPIRES_IN="90d"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3002/api/v1/auth/google/callback"

# ── Storage (Cloudflare R2 in prod, MinIO locally) ────────────────────────────
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET="mlh-assets"
AWS_S3_REGION="auto"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin123"
CDN_URL="http://localhost:9000/mlh-assets"

# ── Storage subfolders ────────────────────────────────────────────────────────
UPLOAD_TEMP_PREFIX="uploads/temp/"
UPLOAD_PERMANENT_PREFIX="uploads/"
PREVIEW_PREFIX="previews/"
TEMPLATE_PREFIX="templates/"

# ── Payment — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Payment — PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_WEBHOOK_ID=""       # PayPal dashboard > Webhooks > webhook ID; leave empty in dev to skip signature verification

# ── Admin auth (NextAuth v4) ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3001"    # must be the full admin URL in production
NEXTAUTH_SECRET="change_me_nextauth_secret_min_32_chars"

# ── Email (SendGrid in prod, MailHog locally) ─────────────────────────────────
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@mapleloomhandmade.com"
EMAIL_FROM_NAME="MapleLoomHandmade"
# Local dev (MailHog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# ── AI / Background Removal ───────────────────────────────────────────────────
BG_REMOVAL_PROVIDER="remove_bg"
BG_REMOVAL_API_KEY=""
BG_REMOVAL_API_URL="https://api.remove.bg/v1.0/removebg"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="mapleloomhandmade-dev"

# ── Next.js Client (NEXT_PUBLIC_* vars must be set at build time) ─────────────
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_CDN_URL="http://localhost:9000/mlh-assets"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Analytics — GA4 Measurement Protocol (server-side, not exposed to client) ─
GA_MEASUREMENT_ID=""        # same value as NEXT_PUBLIC_GA_ID (e.g. G-XXXXXXXXXX)
GA_API_SECRET=""            # GA4 Admin > Data Streams > your stream > Measurement Protocol API secrets
