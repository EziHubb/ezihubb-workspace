# Copy to .env.m5-sandbox.local ONLY after assigning a separate HTTPS M5 stage.
# This file is NOT loaded by AppModule or the foundation runner.
# Replace all placeholders privately. Never use LIVE keys or production URLs.
M5_SANDBOX_SCOPE="M5_READ_ONLY_SANDBOX_BINDINGS"
M5_STAGE_ORIGIN="https://m5-api.example.com"
STRIPE_SECRET_KEY="REPLACE_WITH_STRIPE_TEST_KEY"
STRIPE_ACCOUNT_ID="REPLACE_WITH_EXPECTED_ACCOUNT_ID"
STRIPE_WEBHOOK_ID="REPLACE_WITH_TEST_WEBHOOK_ENDPOINT_ID"
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_ENDPOINT_SIGNING_SECRET"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="REPLACE_WITH_SANDBOX_APP_CLIENT_ID"
PAYPAL_CLIENT_SECRET="REPLACE_WITH_SANDBOX_APP_SECRET"
PAYPAL_WEBHOOK_ID="REPLACE_WITH_SANDBOX_WEBHOOK_ID"
