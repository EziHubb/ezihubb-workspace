FROM node:22-alpine AS base
# python3/make/g++/pkgconf + cairo/pango/jpeg/gif libs: required to compile
# canvas (pulled in by jsdom → vitest; no pre-built musl binary for Node 22)
RUN apk add --no-cache \
    libc6-compat \
    python3 \
    make \
    g++ \
    pkgconf \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    pixman-dev \
    fontconfig-dev
WORKDIR /app
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# scripts/ and prisma/ must be present before pnpm install so the lifecycle
# hooks (postinstall: patch-next-build.cjs, prepare: prisma generate) work.
COPY scripts/ ./scripts/
COPY prisma/ ./prisma/
RUN pnpm install --frozen-lockfile
# prisma.config.ts lives at the repo root (sibling to prisma/), NOT inside
# prisma/ — required for `migrate deploy` to resolve datasource.url from
# DATABASE_URL via the driver adapter. Without it: "the datasource.url
# property is required in your Prisma config file".
COPY prisma.config.ts ./

# ── Production: this single RUN pnpm install layer above also carries the
# apk build toolchain (~430MB, only needed to compile the canvas native
# module) and pnpm's internal store cache — neither is needed to run
# `prisma migrate deploy`. Copy just the resolved node_modules + prisma
# files into a clean image, same pattern as docker/Dockerfile.api/client/
# admin's production stage (was previously single-stage: ~3.2GB vs ~1.5GB).
FROM node:22-alpine AS production
WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/prisma ./prisma
COPY --from=base /app/prisma.config.ts ./
COPY --from=base /app/package.json ./

CMD ["node_modules/.bin/prisma", "migrate", "deploy", "--schema=prisma/schema.prisma"]
