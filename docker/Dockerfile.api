# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
# python3/make/g++/pkgconf + cairo/pango/jpeg/gif libs: required to compile
# canvas (pulled in by jsdom → vitest; no pre-built musl binary for Node 22)
RUN apk add --no-cache \
    libc6-compat \
    python3 \
    make \
    g++ \
    pkgconf \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    pixman-dev \
    fontconfig-dev
WORKDIR /app
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# scripts/ and prisma/ must be present before pnpm install so the lifecycle
# hooks (postinstall: patch-next-build.cjs, prepare: prisma generate) work.
COPY scripts/ ./scripts/
COPY prisma/ ./prisma/
# Cache mount (id shared with Dockerfile.client/.admin/.migrate) so a
# lockfile change doesn't re-download every package from the registry —
# persists across builds/images on the same Docker builder instance.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS development
COPY . .
EXPOSE 3002
CMD ["pnpm", "nx", "serve", "api"]

FROM base AS builder
# Scoped copy (not `COPY . .`) so editing apps/client or apps/admin doesn't
# invalidate this layer and force api to rebuild too — only what `nx build
# api` actually reads: its own app folder, shared libs, and root Nx config.
COPY nx.json tsconfig.base.json tsconfig.json ./
COPY libs/ ./libs/
COPY apps/api/ ./apps/api/
RUN pnpm exec prisma generate --schema=prisma/schema.prisma
# Cache mount (id shared across api/client/admin builds) persists Nx's own
# task cache — libs/ (shared-utils, shared-types, shared-constants, ...) get
# compiled once and reused by whichever app builds next, instead of every
# app image recompiling the same shared libs from scratch.
RUN --mount=type=cache,id=nx-cache,target=/app/.nx/cache \
    pnpm nx build api --configuration=production

FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nestjs
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/dist/apps/api ./dist
COPY --from=builder --chown=nestjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./package.json
USER nestjs
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3002/api/v1/health || exit 1
CMD ["node", "dist/main.js"]
