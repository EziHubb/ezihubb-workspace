{
  "name": "shared-api-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/api-client/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:api-client"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 1
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/api-client",
        "main": "libs/shared/api-client/src/index.ts",
        "tsConfig": "libs/shared/api-client/tsconfig.lib.json",
        "assets": ["libs/shared/api-client/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/shared/api-client/tsconfig.lib.json"
      }
    }
  }
}
